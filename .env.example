# 本文件是模板，复制为 .env 后填入真实 key。`.env` 已在 .gitignore 里。
#
# Google AI Studio API key
# 申请地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-key-here

# 可选：覆盖默认图像模型（默认 gemini-3-pro-image-preview = Nano Banana Pro）
# 可选值：
#   gemini-3-pro-image-preview        Nano Banana Pro（默认，画面质量最好）
#   gemini-3.1-flash-image-preview    Nano Banana 2（速度优先，便宜）
#   gemini-2.5-flash-image            Nano Banana（旧版）
#   imagen-4.0-generate-preview-06-06 Imagen 4
#   imagen-3.0-generate-002           Imagen 3 GA
# IMAGE_MODEL=gemini-3-pro-image-preview

# 可选：长宽比，默认 1:1（与现有图保持一致）
# 可选值：1:1 / 16:9 / 9:16 / 4:3 / 3:4
# IMAGE_ASPECT=1:1

# 可选：是否允许出现人，默认 DONT_ALLOW（仅 Imagen 系列生效）
# 可选值：DONT_ALLOW / ALLOW_ADULT / ALLOW_ALL
# PERSON_GENERATION=DONT_ALLOW
